generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Record {
  id        String   @id @default(cuid())
  title     String
  category  String   // "Prescription", "Lab Report", "Scan", "Other"
  fileUrl   String
  date      DateTime // Date of the record (from user input)
  doctor    String?
  notes     String?
  summary   String?  // AI Summary
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
